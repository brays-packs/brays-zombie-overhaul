		{
			"part": "root",
			"id": "root",
			"invertAxis": "xy",
			"translate": [0, 0, 0],
			"model": "zombie_animations.jpm",
			"animations": [
				{
					"var.jockey": "if(var.first_frame > 0, var.jockey, is_riding, 1, 0)",
					"varb.jockey": "var.jockey == 1",
					"var.time": "var.time + 1 * frame_time",
					"var.y": "if(var.time < 10, frac(pos_y), var.y)",
					"varb.chicken": "varb.jockey && var.y > 0.3 && is_child"
				},
				{
					"head_chicken.visible": "varb.chicken",
					"body_chicken.visible": "varb.chicken",
					"left_arm_chicken.visible": "varb.chicken",
					"right_arm_chicken.visible": "varb.chicken",
					"left_leg_chicken.visible": "varb.chicken",
					"right_leg_chicken.visible": "varb.chicken"
				},
				{
					"var.first_frame": "if(death_time > 0, 0, 1)"
				}
